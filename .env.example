# Local development only. Every value below is already the default, so no .env is needed;
# copy this file to .env only to override one. Never put deployed credentials here.

# PostgreSQL in Docker Compose (bound to localhost)
POSTGRES_DB=hoshizora
POSTGRES_USER=hoshizora
POSTGRES_PASSWORD=hoshizora_dev
POSTGRES_PORT=5432

# Local login roles created by `just migrate`: the ingest writer and the read-only API
HOSHIZORA_INGEST_DB_PASSWORD=hoshizora_ingest_dev
HOSHIZORA_API_DB_PASSWORD=hoshizora_api_dev

# Optional: Launch Library 2 host (https://lldev.thespacedevs.com has no rate limit but stale data)
# HOSHIZORA_LL2_BASE_URL=https://ll.thespacedevs.com

# Reserved for a planned api.nasa.gov source; nothing reads it yet
HOSHIZORA_NASA_API_KEY=
