{
  "name": "hoshizora-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint --max-warnings=0 .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "api:types": "openapi-typescript ../api/openapi.yaml --output src/api/schema.d.ts",
    "api:check": "openapi-typescript ../api/openapi.yaml --output src/api/schema.d.ts --check",
    "e2e": "playwright test",
    "e2e:browsers": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@fontsource-variable/m-plus-1": "5.3.1",
    "@fontsource/ibm-plex-sans-jp": "5.3.1",
    "@react-three/fiber": "9.8.2",
    "@tanstack/react-query": "5.104.3",
    "echarts": "6.1.0",
    "i18next": "26.4.5",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.0.16",
    "react-router": "8.4.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
